# Database Configuration
POSTGRES_USER=cpq_user
POSTGRES_PASSWORD=cpq_secure_password_change_me
POSTGRES_DB=cpq_db
POSTGRES_PORT=5432

# Backend Configuration
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=3000

# Traefik Configuration
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_REPLICAS=0

# NocoDB Configuration
NC_PORT=8081
NC_AUTH_JWT_SECRET=change_this_to_a_random_string
NC_PUBLIC_URL=nc.localhost
NC_ADMIN_EMAIL=admin@example.com
NC_ADMIN_PASSWORD=admin_password_change_me

# NocoDB Base Configuration
BASE_TITLE=CPQ Base
SOURCE_TITLE=CPQ PostgreSQL Source

# Domain Configuration (for production)
CPQ_PUBLIC_DOMAIN=cpq.example.com
